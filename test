int	exec_simple_cmd(t_cmd *cmd, t_env *env)
{
	char	**envp;
	char	**cmd_arg;
	char	*cmd_path;
	int		rc;

	if (!cmd)
		exit(1);

	rc = apply_redirections(cmd, env);
	if (rc == -2)
		exit(130);
	if (rc < 0)
		exit(1);

	envp = env_to_array(env);
	cmd_arg = tokens_to_array(cmd->args);
	if (!cmd_arg)
	{
		free_tab(envp);
		exit(1);
	}
	if (!cmd_arg[0])
	{
		free_tab(cmd_arg);
		free_tab(envp);
		exit(0);
	}
	cmd_path = NULL;
	if (access(cmd_arg[0], X_OK) == 0)
		cmd_path = ft_strdup(cmd_arg[0]);
	if (!cmd_path)
		cmd_path = find_cmd_path(cmd_arg[0], envp);
	if (!cmd_path)
	{
		ft_putstr_fd("minishell: ", 2);
		ft_putstr_fd(cmd_arg[0], 2);
		ft_putstr_fd(": command not found\n", 2);
		free_tab(cmd_arg);
		free_tab(envp);
		exit(127);
	}
	execve(cmd_path, cmd_arg, envp);
	perror("execve");
	free(cmd_path);
	free_tab(cmd_arg);
	free_tab(envp);
	exit(1);
}



